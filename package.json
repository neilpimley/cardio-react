{
  "name": "cardio-react",
  "version": "1.0.0",
  "description": "Website of Dr. Peter McKavanagh, Cardiologist based in Belfast",
  "engines": {
    "node": ">=18 <23"
  },
  "scripts": {
    "start": "node server",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm --prefix frontend ci && npm --prefix frontend run build"
  },
  "cacheDirectories": [
    "node_modules",
    "frontend/node_modules"
  ],
  "dependencies": {
    "body-parser": "^1.18.2",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-sslify": "^1.2.0",
    "mailersend": "^2.6.0",
    "nodemailer": "^4.0.1",
    "path": "^0.12.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neilpimley/cardio-react.git"
  },
  "keywords": [
    "node",
    "heroku",
    "create-react-app",
    "react"
  ],
  "license": "MIT"
}
